<!-- CrowdStrike bridge rules. IDs 110100-110106 are reserved for this integration. -->
<group name="crowdstrike,">
  <rule id="110100" level="3">
    <decoded_as>json</decoded_as>
    <field name="event_type" type="pcre2">.+</field>
    <description>CrowdStrike Falcon event received</description>
    <group>crowdstrike_event,</group>
  </rule>
  <rule id="110101" level="5">
    <if_sid>110100</if_sid>
    <field name="severity" type="pcre2">(?i)^medium$</field>
    <description>CrowdStrike Falcon: medium severity detection on $(crowdstrike_hostname)</description>
    <group>crowdstrike_detection,</group>
  </rule>
  <rule id="110102" level="10">
    <if_sid>110100</if_sid>
    <field name="severity" type="pcre2">(?i)^high$</field>
    <description>CrowdStrike Falcon: high severity detection on $(crowdstrike_hostname)</description>
    <group>crowdstrike_detection,gdpr_IV_35.7.d,</group>
  </rule>
  <rule id="110103" level="12">
    <if_sid>110100</if_sid>
    <field name="severity" type="pcre2">(?i)^critical$</field>
    <description>CrowdStrike Falcon: critical severity detection on $(crowdstrike_hostname)</description>
    <group>crowdstrike_detection,gdpr_IV_35.7.d,</group>
  </rule>
  <rule id="110104" level="7">
    <if_sid>110100</if_sid>
    <field name="event_type">^ProcessRollup2$</field>
    <description>CrowdStrike Falcon: new process telemetry from $(crowdstrike_hostname)</description>
    <group>crowdstrike_telemetry,</group>
  </rule>
  <rule id="110105" level="7">
    <if_sid>110100</if_sid>
    <field name="event_type">^NetworkConnectIP4$</field>
    <description>CrowdStrike Falcon: network connection telemetry from $(crowdstrike_hostname)</description>
    <group>crowdstrike_telemetry,</group>
  </rule>
  <rule id="110106" level="3">
    <if_sid>110100</if_sid>
    <field name="severity" type="pcre2">(?i)^low$</field>
    <description>CrowdStrike Falcon: low severity detection on $(crowdstrike_hostname)</description>
    <group>crowdstrike_detection,</group>
  </rule>
</group>
