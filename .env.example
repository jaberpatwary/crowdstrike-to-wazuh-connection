# Copy this to .env and fill in real values. NEVER commit the real .env file.

# --- CrowdStrike API client (Falcon console > Support > API Clients & Keys) ---
# Scopes needed: Event Streams (Read), and if using FDR: that's provisioned
# separately by CrowdStrike support/your TAM, not via this API client.
CS_CLIENT_ID=
CS_CLIENT_SECRET=
# Use the URL matching your CrowdStrike cloud region:
#   US-1: https://api.crowdstrike.com
#   US-2: https://api.us-2.crowdstrike.com
#   EU-1: https://api.eu-1.crowdstrike.com
CS_BASE_URL=https://api.crowdstrike.com

# --- Event Streams ---
EVENT_STREAMS_ENABLED=true
EVENT_STREAMS_APP_ID=wazuh-bridge

# --- Falcon Data Replicator (ask CrowdStrike to provision this for your CID) ---
FDR_ENABLED=false
FDR_SQS_QUEUE_URL=
FDR_AWS_REGION=us-west-1
FDR_AWS_ACCESS_KEY_ID=
FDR_AWS_SECRET_ACCESS_KEY=

# --- PostgreSQL ---
# This points at a PostgreSQL server running on the HOST machine (not a
# sibling Docker container). host.docker.internal lets the containerized
# bridge reach it; make sure Postgres's listen_addresses/pg_hba.conf allow
# connections from the Docker bridge subnet (see README).
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DATABASE=wazuh
PG_SSLMODE=disable

# --- Wazuh output ---
WAZUH_OUTPUT_PATH=/var/ossec/logs/crowdstrike/crowdstrike-events.json
WAZUH_MAX_FILE_MB=100
WAZUH_MAX_BACKUPS=5

# --- Misc ---
POLL_INTERVAL_SECONDS=30
LOG_LEVEL=info

# Optional historical cutoff; defaults to today's midnight in Asia/Dhaka.
# EVENTS_NOT_BEFORE=2026-10-21T00:00:00+06:00
